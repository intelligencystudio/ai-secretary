{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intelligencystudio/ai-secretary/schemas/secretary-exchange.schema.json",
  "title": "AI Secretary Exchange Protocol",
  "description": "A JSON-RPC friendly protocol for personal AI secretaries to exchange permissioned context and propose mutually useful collaboration options.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/jsonRpcEnvelope" },
    { "$ref": "#/$defs/exchangeBatch" },
    { "$ref": "#/$defs/auditLogEntry" }
  ],
  "$defs": {
    "uri": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "disclosureLevel": {
      "type": "string",
      "enum": ["public", "trusted", "approval_required", "sealed"]
    },
    "riskLevel": {
      "type": "string",
      "enum": ["low", "medium", "high", "blocked"]
    },
    "secretaryRef": {
      "type": "object",
      "required": ["secretaryId", "ownerDisplayName", "agentCardUrl"],
      "additionalProperties": false,
      "properties": {
        "secretaryId": { "$ref": "#/$defs/nonEmptyString" },
        "ownerDisplayName": { "$ref": "#/$defs/nonEmptyString" },
        "organization": { "type": "string" },
        "agentCardUrl": { "$ref": "#/$defs/uri" },
        "a2aUrl": { "$ref": "#/$defs/uri" },
        "publicKey": { "type": "string" },
        "verifiedBy": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "secretaryAgentCard": {
      "type": "object",
      "required": ["name", "description", "url", "version", "protocolVersion", "supportedInterfaces", "skills"],
      "additionalProperties": true,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "url": { "$ref": "#/$defs/uri" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "protocolVersion": { "$ref": "#/$defs/nonEmptyString" },
        "supportedInterfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["url", "protocolBinding", "protocolVersion"],
            "additionalProperties": true,
            "properties": {
              "url": { "$ref": "#/$defs/uri" },
              "protocolBinding": {
                "type": "string",
                "enum": ["JSONRPC", "REST", "SSE", "WEBHOOK"]
              },
              "protocolVersion": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "defaultInputModes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "defaultOutputModes": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": true
        },
        "securitySchemes": {
          "type": "object",
          "additionalProperties": true
        },
        "security": {
          "type": "array",
          "items": { "type": "object" }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "description"],
            "additionalProperties": true,
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "name": { "$ref": "#/$defs/nonEmptyString" },
              "description": { "$ref": "#/$defs/nonEmptyString" },
              "tags": {
                "type": "array",
                "items": { "$ref": "#/$defs/nonEmptyString" },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "privacyPolicy": {
      "type": "object",
      "required": ["defaultDisclosure", "requiresApproval", "neverShare"],
      "additionalProperties": false,
      "properties": {
        "defaultDisclosure": { "$ref": "#/$defs/disclosureLevel" },
        "allowedTopics": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "blockedTopics": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "requiresApproval": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "identity",
              "contacts",
              "documents",
              "calendar",
              "financials",
              "client_data",
              "private_project_data",
              "location",
              "commitments",
              "legal_terms",
              "custom"
            ]
          },
          "uniqueItems": true
        },
        "neverShare": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "credentials",
              "private_keys",
              "access_tokens",
              "passwords",
              "raw_inbox",
              "unapproved_client_data",
              "medical_data",
              "government_id",
              "custom"
            ]
          },
          "uniqueItems": true
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storeInboundCapsules": { "type": "boolean" },
            "storeOutboundCapsules": { "type": "boolean" },
            "ttlDays": { "type": "integer", "minimum": 0 },
            "deleteOnRequest": { "type": "boolean" }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "logEveryExchange": { "type": "boolean" },
            "shareAuditWithOwner": { "type": "boolean" }
          }
        }
      }
    },
    "ownerProfile": {
      "type": "object",
      "required": ["ownerId", "displayName", "roles", "interests", "offers", "asks", "privacy"],
      "additionalProperties": false,
      "properties": {
        "ownerId": { "$ref": "#/$defs/nonEmptyString" },
        "displayName": { "$ref": "#/$defs/nonEmptyString" },
        "organization": { "type": "string" },
        "roles": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "interests": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "offers": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "asks": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": ["open", "selective", "not_available"]
            },
            "timeBudget": { "type": "string" },
            "preferredChannels": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            }
          }
        },
        "privacy": { "$ref": "#/$defs/privacyPolicy" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["type", "summary"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["profile", "project", "document", "conversation", "calendar", "crm", "repository", "manual_note", "other"]
        },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "sourceUrl": { "$ref": "#/$defs/uri" },
        "sourceId": { "type": "string" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "contextCapsule": {
      "type": "object",
      "required": ["capsuleId", "ownerId", "createdAt", "disclosure", "summary", "topics", "payload", "policy"],
      "additionalProperties": false,
      "properties": {
        "capsuleId": { "$ref": "#/$defs/nonEmptyString" },
        "ownerId": { "$ref": "#/$defs/nonEmptyString" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "disclosure": { "$ref": "#/$defs/disclosureLevel" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "payload": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "roles": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            },
            "interests": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            },
            "offers": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            },
            "asks": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            },
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "summary"],
                "additionalProperties": true,
                "properties": {
                  "name": { "$ref": "#/$defs/nonEmptyString" },
                  "summary": { "$ref": "#/$defs/nonEmptyString" },
                  "stage": { "type": "string" },
                  "needs": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/nonEmptyString" }
                  },
                  "offers": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/nonEmptyString" }
                  }
                }
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "policy": {
          "type": "object",
          "required": ["canForward", "requiresApprovalFor"],
          "additionalProperties": false,
          "properties": {
            "canForward": { "type": "boolean" },
            "allowedRecipients": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            },
            "requiresApprovalFor": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            },
            "redactions": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "handshakeRequest": {
      "type": "object",
      "required": ["from", "intent", "requestedDisclosure", "supportedMethods", "profile"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/secretaryRef" },
        "intent": {
          "type": "object",
          "required": ["summary", "topics"],
          "additionalProperties": false,
          "properties": {
            "summary": { "$ref": "#/$defs/nonEmptyString" },
            "topics": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            },
            "desiredOutcome": { "type": "string" }
          }
        },
        "requestedDisclosure": { "$ref": "#/$defs/disclosureLevel" },
        "supportedMethods": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "secretary.handshake",
              "secretary.context.offer",
              "secretary.match.request",
              "secretary.match.propose",
              "secretary.approval.request",
              "secretary.approval.response",
              "secretary.context.release",
              "secretary.introduction.draft",
              "secretary.audit.append"
            ]
          },
          "uniqueItems": true
        },
        "profile": { "$ref": "#/$defs/ownerProfile" }
      }
    },
    "handshakeResponse": {
      "type": "object",
      "required": ["from", "accepted", "acceptedDisclosure", "policy", "profileSummary"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/secretaryRef" },
        "accepted": { "type": "boolean" },
        "acceptedDisclosure": { "$ref": "#/$defs/disclosureLevel" },
        "policy": { "$ref": "#/$defs/privacyPolicy" },
        "profileSummary": {
          "type": "object",
          "required": ["roles", "interests", "offers", "asks"],
          "additionalProperties": false,
          "properties": {
            "roles": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "interests": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "offers": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "asks": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "reason": { "type": "string" }
      }
    },
    "matchRequest": {
      "type": "object",
      "required": ["requestId", "from", "to", "goal", "availableCapsuleIds", "constraints"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/nonEmptyString" },
        "from": { "$ref": "#/$defs/secretaryRef" },
        "to": { "$ref": "#/$defs/secretaryRef" },
        "goal": { "$ref": "#/$defs/nonEmptyString" },
        "availableCapsuleIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "rankingWeights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "opportunityProposal": {
      "type": "object",
      "required": ["proposalId", "title", "summary", "mutualBenefit", "nextSteps", "risk", "confidence"],
      "additionalProperties": false,
      "properties": {
        "proposalId": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "mutualBenefit": {
          "type": "object",
          "required": ["owner", "counterparty"],
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            },
            "counterparty": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "evidenceCapsuleIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "privateDetailsNeeded": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "nextSteps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["action", "owner"],
            "additionalProperties": false,
            "properties": {
              "action": { "$ref": "#/$defs/nonEmptyString" },
              "owner": {
                "type": "string",
                "enum": ["owner", "counterparty", "both", "secretaries"]
              },
              "requiresApproval": { "type": "boolean" }
            }
          }
        },
        "risk": {
          "type": "object",
          "required": ["level", "reasons"],
          "additionalProperties": false,
          "properties": {
            "level": { "$ref": "#/$defs/riskLevel" },
            "reasons": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "matchProposal": {
      "type": "object",
      "required": ["requestId", "generatedAt", "proposals"],
      "additionalProperties": false,
      "properties": {
        "requestId": { "$ref": "#/$defs/nonEmptyString" },
        "generatedAt": { "$ref": "#/$defs/timestamp" },
        "proposals": {
          "type": "array",
          "items": { "$ref": "#/$defs/opportunityProposal" }
        },
        "noMatchReason": { "type": "string" }
      }
    },
    "approvalRequest": {
      "type": "object",
      "required": ["approvalId", "ownerId", "requestedBy", "action", "reason", "dataPreview", "expiresAt"],
      "additionalProperties": false,
      "properties": {
        "approvalId": { "$ref": "#/$defs/nonEmptyString" },
        "ownerId": { "$ref": "#/$defs/nonEmptyString" },
        "requestedBy": { "$ref": "#/$defs/secretaryRef" },
        "action": {
          "type": "string",
          "enum": ["release_private_context", "share_contact", "draft_intro", "schedule_meeting", "send_message", "other"]
        },
        "reason": { "$ref": "#/$defs/nonEmptyString" },
        "dataPreview": {
          "type": "object",
          "additionalProperties": true
        },
        "sensitivity": { "$ref": "#/$defs/disclosureLevel" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "approvalResponse": {
      "type": "object",
      "required": ["approvalId", "ownerId", "decision", "decidedAt"],
      "additionalProperties": false,
      "properties": {
        "approvalId": { "$ref": "#/$defs/nonEmptyString" },
        "ownerId": { "$ref": "#/$defs/nonEmptyString" },
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "needs_changes", "expired"]
        },
        "decidedAt": { "$ref": "#/$defs/timestamp" },
        "allowedFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "redactions": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "comment": { "type": "string" }
      }
    },
    "privateContextRelease": {
      "type": "object",
      "required": ["releaseId", "approvalId", "releasedAt", "capsule"],
      "additionalProperties": false,
      "properties": {
        "releaseId": { "$ref": "#/$defs/nonEmptyString" },
        "approvalId": { "$ref": "#/$defs/nonEmptyString" },
        "releasedAt": { "$ref": "#/$defs/timestamp" },
        "capsule": { "$ref": "#/$defs/contextCapsule" }
      }
    },
    "introductionDraft": {
      "type": "object",
      "required": ["draftId", "proposalId", "subject", "body", "recipients", "requiresApproval"],
      "additionalProperties": false,
      "properties": {
        "draftId": { "$ref": "#/$defs/nonEmptyString" },
        "proposalId": { "$ref": "#/$defs/nonEmptyString" },
        "subject": { "$ref": "#/$defs/nonEmptyString" },
        "body": { "$ref": "#/$defs/nonEmptyString" },
        "recipients": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["displayName"],
            "additionalProperties": false,
            "properties": {
              "displayName": { "$ref": "#/$defs/nonEmptyString" },
              "email": { "type": "string", "format": "email" },
              "secretaryId": { "type": "string" }
            }
          }
        },
        "requiresApproval": { "type": "boolean" }
      }
    },
    "auditLogEntry": {
      "type": "object",
      "required": ["eventId", "timestamp", "actor", "eventType", "summary"],
      "additionalProperties": false,
      "properties": {
        "eventId": { "$ref": "#/$defs/nonEmptyString" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "actor": { "$ref": "#/$defs/secretaryRef" },
        "counterparty": { "$ref": "#/$defs/secretaryRef" },
        "eventType": {
          "type": "string",
          "enum": [
            "handshake_requested",
            "handshake_accepted",
            "context_sent",
            "match_requested",
            "proposal_generated",
            "approval_requested",
            "approval_decided",
            "private_context_released",
            "introduction_drafted",
            "error"
          ]
        },
        "summary": { "$ref": "#/$defs/nonEmptyString" },
        "relatedIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        }
      }
    },
    "jsonRpcEnvelope": {
      "type": "object",
      "required": ["jsonrpc", "id", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": {
          "oneOf": [
            { "type": "string" },
            { "type": "integer" }
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "secretary.handshake",
            "secretary.context.offer",
            "secretary.match.request",
            "secretary.match.propose",
            "secretary.approval.request",
            "secretary.approval.response",
            "secretary.context.release",
            "secretary.introduction.draft",
            "secretary.audit.append"
          ]
        },
        "params": {
          "oneOf": [
            { "$ref": "#/$defs/handshakeRequest" },
            { "$ref": "#/$defs/handshakeResponse" },
            { "$ref": "#/$defs/contextCapsule" },
            { "$ref": "#/$defs/matchRequest" },
            { "$ref": "#/$defs/matchProposal" },
            { "$ref": "#/$defs/approvalRequest" },
            { "$ref": "#/$defs/approvalResponse" },
            { "$ref": "#/$defs/privateContextRelease" },
            { "$ref": "#/$defs/introductionDraft" },
            { "$ref": "#/$defs/auditLogEntry" }
          ]
        }
      }
    },
    "exchangeBatch": {
      "type": "object",
      "required": ["scenarioId", "description", "messages"],
      "additionalProperties": false,
      "properties": {
        "scenarioId": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/jsonRpcEnvelope" }
        }
      }
    }
  }
}
