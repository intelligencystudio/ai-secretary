{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/intelligencystudio/ai-secretary/schemas/secretary-card.schema.json",
  "title": "AI Secretary Card",
  "description": "A self-bootstrapping card that lets Codex, Cowork, or another agent connect to an existing AI secretary or deploy one if missing.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "framework",
    "owner",
    "secretary",
    "bootstrap",
    "receivingAgentInstructions"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "ai-secretary.card"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },
    "cardId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "framework": {
      "type": "object",
      "required": ["name", "repository", "bootstrapPrompt"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "AI Secretary"
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "schemaUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "uniqueItems": true
        },
        "bootstrapPrompt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "owner": {
      "type": "object",
      "required": ["ownerId", "displayName", "roles", "interests", "offers", "asks", "privacy"],
      "additionalProperties": false,
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "interests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "offers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "asks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "privacy": {
          "$ref": "secretary-exchange.schema.json#/$defs/privacyPolicy"
        }
      }
    },
    "secretary": {
      "type": "object",
      "required": ["status", "preferredProtocol", "agentCardUrl", "a2aUrl"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["deployed", "not_deployed", "unknown"]
        },
        "preferredProtocol": {
          "type": "string",
          "enum": ["A2A_JSONRPC", "REST_FALLBACK"]
        },
        "agentCardUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "a2aUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "restContextUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "publicBaseUrl": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "authHint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["none", "bearer", "api_key", "approval_required"]
            },
            "instructions": {
              "type": "string"
            }
          }
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["ifSecretaryMissing", "ifSecretaryPresent", "requiredArtifacts"],
      "additionalProperties": false,
      "properties": {
        "ifSecretaryMissing": {
          "type": "object",
          "required": ["goal", "steps"],
          "additionalProperties": false,
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ifSecretaryPresent": {
          "type": "object",
          "required": ["steps"],
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "requiredArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "agent_card",
              "a2a_endpoint",
              "owner_profile",
              "privacy_policy",
              "context_capsules",
              "approval_gate",
              "audit_log",
              "public_contact_url"
            ]
          },
          "uniqueItems": true
        },
        "preferredRuntime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "localFirst": { "type": "boolean" },
            "publishVia": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["ngrok", "cloudflare_tunnel", "public_host", "manual"]
              },
              "uniqueItems": true
            },
            "storage": {
              "type": "string",
              "enum": ["local_json", "sqlite", "hosted_database", "manual"]
            }
          }
        }
      }
    },
    "initialContextCapsules": {
      "type": "array",
      "items": {
        "$ref": "secretary-exchange.schema.json#/$defs/contextCapsule"
      }
    },
    "receivingAgentInstructions": {
      "type": "object",
      "required": ["mode", "seamlessExperience", "approvalRules", "output"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["connect_or_bootstrap"]
        },
        "seamlessExperience": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approvalRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "active_agent_card_url",
              "active_a2a_url",
              "owner_profile_summary",
              "privacy_policy_summary",
              "initial_context_capsules",
              "next_action"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
